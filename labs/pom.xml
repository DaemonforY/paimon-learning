<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Paimon 学习实验项目：在本地嵌入式运行 Flink SQL，读写 Paimon 表 -->
    <groupId>learning.paimon</groupId>
    <artifactId>paimon-labs</artifactId>
    <version>1.0</version>

    <properties>
        <!-- Flink 2.x 的 jar 是 Java 11 字节码，所以这里也按 11 编译 -->
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 默认 Flink 2.2.0 + paimon-flink-2.2（Paimon 正式支持的组合）。
             对照旧结果时用 -Dflink.version=1.20.1 -Dpaimon.flink.module=1.20 -->
        <flink.version>2.2.0</flink.version>
        <paimon.flink.module>2.2</paimon.flink.module>
        <!-- 默认使用 Maven Central 正式版；对照源码调试时用 -Dpaimon.version=2.2-SNAPSHOT 等本地编译版本 -->
        <paimon.version>2.0.0</paimon.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-flink-${paimon.flink.module}</artifactId>
            <version>${paimon.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-api-java-bridge</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-planner_2.12</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-table-runtime</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <!-- Paimon 读取端需要：FileStoreSourceReader 继承 connector-base 的 SingleThreadMultiplexSourceReaderBase，
             FileStoreSourceSplitReader 返回 BulkFormat.RecordIterator。
             flink-connector-files 已经把 flink-connector-base 的类 shade 进来了，所以只需要这一个（实验 5 验证）。
             Flink 发行版 lib/ 里自带。 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-files</artifactId>
            <version>${flink.version}</version>
        </dependency>
        <!-- 实验 14：REST Catalog 的参考服务端 RESTCatalogServer 在 paimon-core 的 tests jar 里，基于 okhttp 的 MockWebServer。
             tests jar 只要它自己的类（Paimon 主体类已在 paimon-flink 的 bundle 里），所以排除传递依赖 -->
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-core</artifactId>
            <version>${paimon.version}</version>
            <classifier>tests</classifier>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- flink-shaded-hadoop-2-uber 里带了未 shade 的老版本 okio；把 okhttp / okio 3.x 声明为直接依赖并放在它前面，
             保证 classpath 上先出现新版本（否则 MockWebServer 启动时报 NoSuchFieldError: Companion） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okio</groupId>
            <artifactId>okio-jvm</artifactId>
            <version>3.6.0</version>
        </dependency>
        <!-- Paimon 在 Flink 中需要 Hadoop 类（生产部署同样要放这个 jar 到 flink/lib） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-shaded-hadoop-2-uber</artifactId>
            <version>2.8.3-10.0</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 日志：与 Flink 发行版一致的 log4j2 组合；1.2-api 供 Hadoop 使用 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-1.2-api</artifactId>
            <version>2.25.5</version>
        </dependency>
    </dependencies>
</project>
